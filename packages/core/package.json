    "pdfjs-dist": "^6.3.289",
    "pino": "^9.6.0",
    "playwright-core": "^1.49.1",
    "sql.js": "^1.12.0",
    "systeminformation": "^5.23.7",
    "trash": "^9.0.0",
    "uuid": "^11.0.3",
