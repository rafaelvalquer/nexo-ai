{
  "name": "@nexo/desktop",
  "version": "0.7.0-beta.1",
  "description": "Nexo AI local office agent",
  "author": "Nexo AI",
  "copyright": "Copyright © 2026 Nexo AI",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm build:renderer && pnpm build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package:win": "pnpm build && electron-builder --win --dir && electron-builder --win nsis --publish never --prepackaged ../../release/win-unpacked",
    "package:win:publish": "pnpm build && electron-builder --win --dir && electron-builder --win nsis --publish always --prepackaged ../../release/win-unpacked",
    "publish:win:verified": "electron-builder --win nsis --publish always --prepackaged ../../release/win-unpacked"
  },
  "dependencies": {
    "@nexo/browser-agent": "workspace:*",
    "@nexo/core": "workspace:*",
    "@nexo/shared": "workspace:*",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "pixi.js": "^8.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "39.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "ai.nexo.desktop",
    "productName": "Nexo AI",
    "executableName": "NexoAI",
    "directories": {"output": "../../release"},
    "asar": true,
    "files": ["dist/**/*","dist-electron/**/*","resources/icons/**/*","package.json"],
    "publish": [{"provider":"github","owner":"rafaelvalquer","repo":"nexo-ai"}],
    "win": {"icon":"resources/icons/icon.ico","publisherName":"Nexo AI","target":["nsis"],"artifactName":"NexoAI-Setup-${version}.${ext}"},
    "mac": {"icon":"resources/icons/icon.icns"},
    "nsis": {"oneClick":false,"allowToChangeInstallationDirectory":true}
  }
}
